-- ============================================================
-- VALIDATION / TARGETING
-- ============================================================
local function valid(plr)
    if not plr or plr == LP then return false end
    local ch = plr.Character
    if not ch then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function teamOK(plr)
    if not Config.TeamCheck then return true end
    if not LP.Team or not plr.Team then return true end
    return LP.Team.Name ~= plr.Team.Name
end

local function distance(plr)
    local ch = plr.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return math.huge end
    return (Camera.CFrame.Position - hrp.Position).Magnitude
end

local function visible(plr)
    if not Config.VisibleCheck then return true end
    local ch = plr.Character
    if not ch then return false end
    local part = ch:FindFirstChild(Config.TargetPart) or ch:FindFirstChild("HumanoidRootPart")
    if not part then return false end
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { LP.Character, Camera }
    params.FilterType = Enum.RaycastFilterType.Exclude
    local res = WS:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, params)
    if not res then return true end
    return res.Instance:IsDescendantOf(ch)
end

local function pickTarget()
    if Config.SelectedTarget and valid(Config.SelectedTarget) and teamOK(Config.SelectedTarget) then
        return Config.SelectedTarget
    end
    if not Config.AutoLock then return nil end

    local best, bestScore = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if valid(plr) and teamOK(plr) then
            local ch = plr.Character
            local part = ch:FindFirstChild(Config.TargetPart) or ch:FindFirstChild("HumanoidRootPart")
            if part then
                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local d2 = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d2 <= Config.FOV and d2 < bestScore and visible(plr) then
                        bestScore = d2
                        best = plr
                    end
                end
            end
        end
    end
    return best
end

-- ============================================================
-- AIM LOOP
-- ============================================================
local aiming = false
UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Config.LockKey then
        if Config.LockHold then aiming = true else aiming = not aiming end
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.KeyCode == Config.LockKey and Config.LockHold then aiming = false end
end)

RunSvc.RenderStepped:Connect(function(dt)
    if not (aiming and Config.LockEnabled) then return end
    local target = pickTarget()
    if not target then return end
    local ch = target.Character
    if not ch then return end
    local part = ch:FindFirstChild(Config.TargetPart) or ch:FindFirstChild("HumanoidRootPart")
    if not part then return end

    local pos = part.Position
    if part.AssemblyLinearVelocity then
        pos = pos + part.AssemblyLinearVelocity * Config.Prediction
    end

    local goal = CFrame.lookAt(Camera.CFrame.Position, pos)
    local alpha = math.clamp(Config.Smoothness * dt, 0, 1)
    Camera.CFrame = Camera.CFrame:Lerp(goal, alpha)
end)

-- ============================================================
-- ESP (Drawing API)
-- ============================================================
local hasDrawing = (typeof(Drawing) == "table" and Drawing.new ~= nil)
local ESPCache = {}

local function newText()
    local t = Drawing.new("Text")
    t.Size = 13; t.Center = true; t.Outline = true; t.OutlineColor = Color3.new(0,0,0)
    t.Color = C.text; t.Font = 2; t.Visible = false
    return t
end

local function buildESP(plr)
    return {
        box       = Drawing.new("Square"),
        name      = newText(),
        dist      = newText(),
        healthBg  = Drawing.new("Square"),
        health    = Drawing.new("Square"),
        tracer    = Drawing.new("Line"),
    }
end

local function hideAll(cache)
    for _, d in next, cache do
        pcall(function() d.Visible = false end)
    end
end

local fovCircle = hasDrawing and Drawing.new("Circle") or nil
if fovCircle then
    fovCircle.Thickness = 1
    fovCircle.NumSides = 64
    fovCircle.Filled = false
    fovCircle.Color = C.accent
    fovCircle.Transparency = 0.4
end

local function updateESP()
    if not hasDrawing then return end
    if not Config.ESP then
        for _, c in next, ESPCache do hideAll(c) end
        return
    end
    local seen = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and valid(plr) and teamOK(plr) then
            seen[plr] = true
            local cache = ESPCache[plr]
            if not cache then
                cache = buildESP(plr)
                ESPCache[plr] = cache
            end
            local ch = plr.Character
            local hum = ch:FindFirstChildOfClass("Humanoid")
            local head = ch:FindFirstChild("Head")
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            if hum and head and hrp then
                local cf, size = ch:GetBoundingBox()
                local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
                local anyOn = false
                for ix = 0, 1 do for iy = 0, 1 do for iz = 0, 1 do
                    local cornerV = cf * Vector3.new((ix*2-1)*size.X/2, (iy*2-1)*size.Y/2, (iz*2-1)*size.Z/2)
                    local sp, on = Camera:WorldToViewportPoint(cornerV)
                    if on then
                        anyOn = true
                        minX = math.min(minX, sp.X); maxX = math.max(maxX, sp.X)
                        minY = math.min(minY, sp.Y); maxY = math.max(maxY, sp.Y)
                    end
                end end end

                if anyOn then
                    local bw, bh = maxX - minX, maxY - minY
                    local headPos, headOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))

                    cache.box.Size = Vector2.new(bw, bh)
                    cache.box.Position = Vector2.new(minX, minY)
                    cache.box.Color = C.accent
                    cache.box.Thickness = 1
                    cache.box.Visible = Config.BoxESP

                    if headOn then
                        cache.name.Text = plr.Name
                        cache.name.Position = Vector2.new(headPos.X, headPos.Y)
                        cache.name.Visible = Config.NameESP

                        cache.dist.Text = math.floor(distance(plr)) .. "m"
                        cache.dist.Position = Vector2.new(headPos.X, headPos.Y + 15)
                        cache.dist.Color = C.sub
                        cache.dist.Visible = Config.DistanceESP
                    else
                        cache.name.Visible = false
                        cache.dist.Visible = false
                    end

                    local pct = hum.Health / hum.MaxHealth
                    cache.healthBg.Size = Vector2.new(3, bh)
                    cache.healthBg.Position = Vector2.new(minX - 7, minY)
                    cache.healthBg.Filled = true
                    cache.healthBg.Color = Color3.fromRGB(25, 25, 35)
                    cache.healthBg.Visible = Config.HealthESP

                    cache.health.Size = Vector2.new(3, bh * pct)
                    cache.health.Position = Vector2.new(minX - 7, minY + bh * (1 - pct))
                    cache.health.Filled = true
                    cache.health.Color = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(120, 255, 140), pct)
                    cache.health.Visible = Config.HealthESP

                    cache.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    cache.tracer.To = Vector2.new((minX + maxX) / 2, maxY)
                    cache.tracer.Color = C.accent
                    cache.tracer.Thickness = 1
                    cache.tracer.Visible = Config.TracerESP
                else
                    hideAll(cache)
                end
            else
                hideAll(cache)
            end
        end
    end
    for plr, cache in next, ESPCache do
        if not seen[plr] then
            for _, d in next, cache do pcall(function() d:Remove() end) end
            ESPCache[plr] = nil
        end
    end
end

