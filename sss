-- FAST RELOAD / FAST STOP / SPEED / SPIDER / STEP / NOCLIP
-- ============================================================
local reloadDebounce = 0
local function fastReload()
    if unloaded then return end
    local now = tick()
    if now - reloadDebounce < 0.1 then return end
    reloadDebounce = now
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local tool = char:FindFirstChildOfClass("Tool")
    if not (hum and tool) then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
        if ok and tracks then
            for _, t in ipairs(tracks) do
                local len = 0
                pcall(function() len = t.Length end)
                if len > 0.4 and len < 3 and t.TimePosition < len - 0.1 then
                    pcall(function() t.TimePosition = len - 0.05 end)
                end
            end
        end
    end
    for _, name in ipairs({"Reloading","IsReloading","Reload","ReloadState"}) do
        local v = tool:FindFirstChild(name, true)
        if v and v:IsA("BoolValue") then pcall(function() v.Value = false end) end
    end
    for _, pair in ipairs({
        {"Ammo","MaxAmmo"}, {"Clip","MaxClip"}, {"Mag","MaxMag"},
        {"CurrentAmmo","MaxAmmo"}, {"Bullets","MaxBullets"},
    }) do
        local cur = tool:FindFirstChild(pair[1], true)
        local mx = tool:FindFirstChild(pair[2], true)
        if cur and mx and (cur:IsA("IntValue") or cur:IsA("NumberValue")) and (mx:IsA("IntValue") or mx:IsA("NumberValue")) then
            pcall(function() cur.Value = mx.Value end)
        end
    end
end

local noClipConns = {}
local function setNoClip(on)
    if on then
        table.insert(noClipConns, RunSvc.Stepped:Connect(function()
            if unloaded then return end
            local ch = LP.Character
            if not ch then return end
            for _, d in ipairs(ch:GetDescendants()) do
                if d:IsA("BasePart") and d.CanCollide then d.CanCollide = false end
            end
        end))
    else
        for _, c in ipairs(noClipConns) do pcall(function() c:Disconnect() end) end
        noClipConns = {}
    end
end

