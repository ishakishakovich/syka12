-- ============================================================
-- STICKY TARGETING
-- ============================================================
local stickyTarget = nil
local stickyLostAt = 0

local function inFOV(plr)
    local part = getPart(plr)
    if not part then return false end
    local sp, on = Camera:WorldToViewportPoint(part.Position)
    if not on then return false end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    return (Vector2.new(sp.X, sp.Y) - center).Magnitude <= Config.FOV
end

local function pickTarget()
    -- manual override wins
    if Config.SelectedTarget and valid(Config.SelectedTarget) and teamOK(Config.SelectedTarget) then
        return Config.SelectedTarget
    end
    if not Config.AutoLock then return nil end

    local now = tick()

    -- sticky: keep current target if still valid + in FOV + visible, else start release timer
    if stickyTarget and valid(stickyTarget) and teamOK(stickyTarget) then
        if inFOV(stickyTarget) and visible(stickyTarget) then
            stickyLostAt = 0
            return stickyTarget
        end
        if stickyLostAt == 0 then stickyLostAt = now end
        if now - stickyLostAt < Config.StickyRelease then
            return stickyTarget
        end
        stickyTarget = nil
        stickyLostAt = 0
    end

    -- pick best by screen distance
    local best, bestScore = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if valid(plr) and teamOK(plr) then
            local part = getPart(plr)
            if part then
                local sp, on = Camera:WorldToViewportPoint(part.Position)
                if on then
                    local d2 = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d2 <= Config.FOV and d2 < bestScore and visible(plr) then
                        bestScore = d2; best = plr
                    end
                end
            end
        end
    end
    if best then
        stickyTarget = best
        stickyLostAt = 0
    end
    return best
end

-- ============================================================
-- ESP
-- ============================================================
local hasDrawing = (typeof(Drawing) == "table" and Drawing.new ~= nil)
local ESPCache = {}

local function newText()
    local t = Drawing.new("Text")
    t.Size = 13; t.Center = true; t.Outline = true; t.OutlineColor = Color3.new(0,0,0)
    t.Color = C.text; t.Font = 2; t.Visible = false
    return t
end

local function buildESP()
    return {
        box = Drawing.new("Square"),
        name = newText(), dist = newText(),
        healthBg = Drawing.new("Square"), health = Drawing.new("Square"),
        tracer = Drawing.new("Line"),
    }
end

local function hideAll(c)
    for _, d in next, c do pcall(function() d.Visible = false end) end
end

local fovCircle = hasDrawing and Drawing.new("Circle") or nil
if fovCircle then
    fovCircle.Thickness = 1; fovCircle.NumSides = 64; fovCircle.Filled = false
    fovCircle.Color = C.accent; fovCircle.Transparency = 0.4
end

local function updateESP()
    if unloaded or not hasDrawing then return end
    if not Config.ESP then
        for _, c in next, ESPCache do hideAll(c) end
        return
    end
    local seen = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and valid(plr) and teamOK(plr) then
            seen[plr] = true
            local c = ESPCache[plr]
            if not c then c = buildESP(); ESPCache[plr] = c end
            local ch = plr.Character
            local hum = ch:FindFirstChildOfClass("Humanoid")
            local head = ch:FindFirstChild("Head")
            if hum and head then
                local cf, size = ch:GetBoundingBox()
                local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
                local anyOn = false
                for ix = 0, 1 do for iy = 0, 1 do for iz = 0, 1 do
                    local sp, on = Camera:WorldToViewportPoint(cf * Vector3.new((ix*2-1)*size.X/2, (iy*2-1)*size.Y/2, (iz*2-1)*size.Z/2))
                    if on then
                        anyOn = true
                        minX = math.min(minX, sp.X); maxX = math.max(maxX, sp.X)
                        minY = math.min(minY, sp.Y); maxY = math.max(maxY, sp.Y)
                    end
                end end end
                if anyOn then
                    local bw, bh = maxX - minX, maxY - minY
                    local hPos, hOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
                    c.box.Size = Vector2.new(bw, bh)
                    c.box.Position = Vector2.new(minX, minY)
                    c.box.Color = C.accent
                    c.box.Thickness = 1
                    c.box.Visible = Config.BoxESP
                    if hOn then
                        c.name.Text = plr.Name
                        c.name.Position = Vector2.new(hPos.X, hPos.Y)
                        c.name.Visible = Config.NameESP
                        c.dist.Text = math.floor(distance(plr)) .. "m"
                        c.dist.Position = Vector2.new(hPos.X, hPos.Y + 15)
                        c.dist.Color = C.sub
                        c.dist.Visible = Config.DistanceESP
                    else
                        c.name.Visible = false; c.dist.Visible = false
                    end
                    local pct = hum.Health / hum.MaxHealth
                    c.healthBg.Size = Vector2.new(3, bh)
                    c.healthBg.Position = Vector2.new(minX - 7, minY)
                    c.healthBg.Filled = true
                    c.healthBg.Color = Color3.fromRGB(25, 25, 35)
                    c.healthBg.Visible = Config.HealthESP
                    c.health.Size = Vector2.new(3, bh * pct)
                    c.health.Position = Vector2.new(minX - 7, minY + bh * (1 - pct))
                    c.health.Filled = true
                    c.health.Color = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(120, 255, 140), pct)
                    c.health.Visible = Config.HealthESP
                    c.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    c.tracer.To = Vector2.new((minX + maxX) / 2, maxY)
                    c.tracer.Color = C.accent
                    c.tracer.Thickness = 1
                    c.tracer.Visible = Config.TracerESP
                else hideAll(c) end
            else hideAll(c) end
        end
    end
    for plr, c in next, ESPCache do
        if not seen[plr] then
            for _, d in next, c do pcall(function() d:Remove() end) end
            ESPCache[plr] = nil
        end
    end
end

