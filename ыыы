local function updatePlayerList()
    ListFrame.Visible = Config.PlayerList
    if not Config.PlayerList then return end

    for _, ch in ipairs(listScroll:GetChildren()) do
        if ch:IsA("Frame") and ch.Name == "Row" then ch:Destroy() end
    end

    local plrs = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then table.insert(plrs, p) end
    end
    table.sort(plrs, function(a, b) return distance(a) < distance(b) end)

    local y = 0
    for _, plr in ipairs(plrs) do
        local isSel = (plr == Config.SelectedTarget)
        local row = mk("TextButton", {
            Name = "Row",
            Size = UDim2.new(1, -4, 0, 30), Position = UDim2.new(0, 2, 0, y),
            BackgroundColor3 = isSel and C.accentD or C.panel,
            Text = "", AutoButtonColor = false,
        }, listScroll)
        corner(row, 5)

        mk("Frame", {
            Size = UDim2.fromOffset(6, 6), Position = UDim2.new(0, 10, 0, 12),
            BackgroundColor3 = valid(plr) and C.good or C.bad,
        }, row)
        local dot = row:FindFirstChildWhichIsA("Frame"); if dot then corner(dot, 3) end

        mk("TextLabel", {
            Size = UDim2.new(1, -80, 0, 14), Position = UDim2.new(0, 22, 0, 4),
            BackgroundTransparency = 1, Text = plr.Name,
            TextSize = 11, Font = Enum.Font.GothamMedium,
            TextColor3 = isSel and C.text or Color3.fromRGB(200, 200, 215),
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)
        mk("TextLabel", {
            Size = UDim2.new(1, -80, 0, 12), Position = UDim2.new(0, 22, 0, 16),
            BackgroundTransparency = 1, Text = math.floor(distance(plr)) .. "m",
            TextSize = 10, Font = Enum.Font.Gotham,
            TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left,
        }, row)

        row.MouseButton1Click:Connect(function()
            if Config.SelectedTarget == plr then
                Config.SelectedTarget = nil
            else
                Config.SelectedTarget = plr
            end
        end)
        y = y + 34
    end
    listScroll.CanvasSize = UDim2.new(0, 0, 0, y + 4)
end

local function updateHUD()
    HudFrame.Visible = Config.TargetHUD and Config.SelectedTarget ~= nil
    if not HudFrame.Visible then return end
    local t = Config.SelectedTarget
    if not valid(t) then HudFrame.Visible = false; return end
    local ch = t.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    HudName.Text = t.Name
    HudInfo.Text = "dist: " .. math.floor(distance(t)) .. "m   ·   hp: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
    local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
    HudBar.Size = UDim2.new(pct, 0, 1, 0)
    HudBar.BackgroundColor3 = Color3.fromRGB(255, 60, 60):Lerp(C.good, pct)
end

