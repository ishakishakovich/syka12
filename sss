-- ESP  (box, name, health, dist, tracer, skeleton, chams, cash)
-- ============================================================
local hasDrawing = (typeof(Drawing) == "table" and Drawing.new ~= nil)
local ESPCache = {}
local ChamsCache = {}
local CashCache = {}
local SkeletonBones = {
    {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"}, {"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"}, {"LeftUpperLeg","LeftLowerLeg"}, {"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"}, {"RightLowerLeg","RightFoot"},
}

local function newText()
    local t = Drawing.new("Text")
    t.Size = 13; t.Center = true; t.Outline = true; t.OutlineColor = Color3.new(0,0,0)
    t.Color = C.text; t.Font = 2; t.Visible = false
    return t
end

local function buildESP()
    local cache = {
        box = Drawing.new("Square"),
        name = newText(), dist = newText(),
        healthBg = Drawing.new("Square"), health = Drawing.new("Square"),
        tracer = Drawing.new("Line"),
        bones = {},
    }
    for i = 1, #SkeletonBones do
        local line = Drawing.new("Line")
        line.Thickness = 1; line.Color = C.accent; line.Visible = false
        cache.bones[i] = line
    end
    return cache
end

local function hideAll(c)
    for k, d in next, c do
        if k == "bones" then
            for _, l in ipairs(d) do pcall(function() l.Visible = false end) end
        else
            pcall(function() d.Visible = false end)
        end
    end
end

local fovCircle = hasDrawing and Drawing.new("Circle") or nil
if fovCircle then
    fovCircle.Thickness = 1; fovCircle.NumSides = 64; fovCircle.Filled = false
    fovCircle.Color = C.accent; fovCircle.Transparency = 0.4
end

local function updateESP()
    if unloaded or not hasDrawing then return end
    if not Config.ESP then
        for _, c in next, ESPCache do hideAll(c) end
        for _, h in next, ChamsCache do pcall(function() h:Destroy() end) end
        ChamsCache = {}
        return
    end
    local seen = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and valid(plr) and teamOK(plr) then
            seen[plr] = true
            local c = ESPCache[plr]
            if not c then c = buildESP(); ESPCache[plr] = c end
            local ch = plr.Character
            local hum = ch:FindFirstChildOfClass("Humanoid")
            local head = ch:FindFirstChild("Head")
            if hum and head then
                local cf, size = ch:GetBoundingBox()
                local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
                local anyOn = false
                for ix = 0, 1 do for iy = 0, 1 do for iz = 0, 1 do
                    local sp, on = Camera:WorldToViewportPoint(cf * Vector3.new((ix*2-1)*size.X/2, (iy*2-1)*size.Y/2, (iz*2-1)*size.Z/2))
                    if on then
                        anyOn = true
                        minX = math.min(minX, sp.X); maxX = math.max(maxX, sp.X)
                        minY = math.min(minY, sp.Y); maxY = math.max(maxY, sp.Y)
                    end
                end end end
                if anyOn then
                    local bw, bh = maxX - minX, maxY - minY
                    local hPos, hOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
                    c.box.Size = Vector2.new(bw, bh)
                    c.box.Position = Vector2.new(minX, minY)
                    c.box.Color = C.accent
                    c.box.Thickness = 1
                    c.box.Visible = Config.BoxESP
                    if hOn then
                        c.name.Text = plr.Name
                        c.name.Position = Vector2.new(hPos.X, hPos.Y)
                        c.name.Visible = Config.NameESP
                        c.dist.Text = math.floor(distance(plr)) .. "m"
                        c.dist.Position = Vector2.new(hPos.X, hPos.Y + 15)
                        c.dist.Color = C.sub
                        c.dist.Visible = Config.DistanceESP
                    else
                        c.name.Visible = false; c.dist.Visible = false
                    end
                    local pct = hum.Health / hum.MaxHealth
                    c.healthBg.Size = Vector2.new(3, bh)
                    c.healthBg.Position = Vector2.new(minX - 7, minY)
                    c.healthBg.Filled = true
                    c.healthBg.Color = Color3.fromRGB(25, 25, 35)
                    c.healthBg.Visible = Config.HealthESP
                    c.health.Size = Vector2.new(3, bh * pct)
                    c.health.Position = Vector2.new(minX - 7, minY + bh * (1 - pct))
                    c.health.Filled = true
                    c.health.Color = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(120, 255, 140), pct)
                    c.health.Visible = Config.HealthESP

                    -- tracer origin
                    local from = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    if Config.TracerOrigin == "crosshair" then
                        from = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    elseif Config.TracerOrigin == "character" then
                        local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                        if myHrp then
                            local sp, on = Camera:WorldToViewportPoint(myHrp.Position)
                            if on then from = Vector2.new(sp.X, sp.Y) end
                        end
                    end
                    c.tracer.From = from
                    c.tracer.To = Vector2.new((minX + maxX) / 2, maxY)
                    c.tracer.Color = C.accent
                    c.tracer.Thickness = 1
                    c.tracer.Visible = Config.TracerESP

                    -- skeleton
                    if Config.SkeletonESP then
                        for i, bone in ipairs(SkeletonBones) do
                            local p1 = ch:FindFirstChild(bone[1])
                            local p2 = ch:FindFirstChild(bone[2])
                            if p1 and p2 then
                                local a, aOn = Camera:WorldToViewportPoint(p1.Position)
                                local b, bOn = Camera:WorldToViewportPoint(p2.Position)
                                local line = c.bones[i]
                                if aOn and bOn then
                                    line.From = Vector2.new(a.X, a.Y)
                                    line.To = Vector2.new(b.X, b.Y)
                                    line.Visible = true
                                else
                                    line.Visible = false
                                end
                            end
                        end
                    else
                        for _, line in ipairs(c.bones) do pcall(function() line.Visible = false end) end
                    end
                else hideAll(c) end
            else hideAll(c) end

            -- chams
            if Config.Chams then
                local h = ChamsCache[plr]
                if not h then
                    h = Instance.new("Highlight")
                    h.Name = "ShChams"
                    h.FillColor = C.accent
                    h.FillTransparency = 0.55
                    h.OutlineColor = C.accent
                    h.OutlineTransparency = 0
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent = (gethui and gethui()) or game:GetService("CoreGui")
                    ChamsCache[plr] = h
                end
                h.Adornee = plr.Character
            else
                local h = ChamsCache[plr]
                if h then h:Destroy(); ChamsCache[plr] = nil end
            end
        end
    end
    for plr, c in next, ESPCache do
        if not seen[plr] then
            for k, d in next, c do
                if k == "bones" then
                    for _, l in ipairs(d) do pcall(function() l:Remove() end) end
                else
                    pcall(function() d:Remove() end)
                end
            end
            ESPCache[plr] = nil
        end
    end
    for plr, h in next, ChamsCache do
        if not seen[plr] then h:Destroy(); ChamsCache[plr] = nil end
    end
end

