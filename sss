-- FLY (multi-mode)
-- ============================================================
local flyConn = nil
local flySaved = nil

local function setFly(on)
    if unloaded then return end
    Config.FlyEnabled = on
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if on then
        if not hum then return end
        if flyConn then return end
        flySaved = { WalkSpeed = hum.WalkSpeed, PlatformStand = hum.PlatformStand }
        hum.PlatformStand = true
        hum.WalkSpeed = 0
        local lastVel = Vector3.zero
        flyConn = RunSvc.RenderStepped:Connect(function(dt)
            if unloaded then return end
            local c = LP.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if not r then return end
            local cam = Camera
            local move = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end

            local mode = Config.FlyMode
            local speed = Config.FlySpeed

            if mode == "hover" then
                if move.Magnitude > 0 then
                    r.CFrame = r.CFrame + move.Unit * speed * dt
                end
            elseif mode == "matrix" then
                if move.Magnitude > 0 then
                    -- matrix = quick dash, velocity cap raised
                    local dash = math.min(speed * 2, 90)
                    r.CFrame = r.CFrame + move.Unit * dash * dt
                end
            elseif mode == "elytra" then
                if move.Magnitude > 0 then
                    r.CFrame = r.CFrame + move.Unit * speed * dt
                else
                    -- glide down like elytra
                    r.CFrame = r.CFrame + Vector3.new(0, -14 * dt, 0) + cam.CFrame.LookVector * speed * 0.4 * dt
                end
            else -- glide
                if move.Magnitude > 0 then
                    r.CFrame = r.CFrame + move.Unit * speed * dt
                else
                    r.CFrame = r.CFrame + Vector3.new(0, -8 * dt, 0)
                end
            end
            lastVel = move
        end)
    else
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        if flySaved and hum then
            hum.PlatformStand = flySaved.PlatformStand
            hum.WalkSpeed = flySaved.WalkSpeed
            flySaved = nil
        end
    end
end

LP.CharacterRemoving:Connect(function()
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    flySaved = nil
end)
LP.CharacterAdded:Connect(function()
    if unloaded then return end
    if Config.FlyEnabled then
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        flySaved = nil
        task.wait(0.5)
        if Config.FlyEnabled and not unloaded then setFly(true) end
    end
end)

