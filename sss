-- ============================================================
local function findCashParts()
    local list = {}
    for _, d in ipairs(WS:GetDescendants()) do
        if d:IsA("BasePart") then
            local n = d.Name:lower()
            if n:find("cash") or n:find("money") or n:find("dollar") then
                table.insert(list, d)
            end
        end
    end
    return list
end

local function findNearestBag()
    local best, bestD = nil, math.huge
    local myPos = Camera.CFrame.Position
    for _, d in ipairs(WS:GetDescendants()) do
        if d:IsA("BasePart") then
            local n = d.Name:lower()
            if (n:find("bag") or n:find("dropped") or n:find("moneybag")) and not n:find("tool") then
                local dd = (myPos - d.Position).Magnitude
                if dd < bestD then bestD = dd; best = d end
            end
        end
    end
    return best
end

