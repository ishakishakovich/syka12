    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 4)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = ListScroll

    local function rebuild()
        for plr, row in pairs(RowByPlayer) do
            row:Destroy()
            RowByPlayer[plr] = nil
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 26)
            btn.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Font = Enum.Font.Code
            btn.TextSize = 12
            btn.BorderSizePixel = 0
            btn.AutoButtonColor = false
            btn.Text = "  " .. plr.Name
            btn.TextColor3 = isInTargetList(plr) and Color3.fromRGB(120, 220, 160) or Color3.fromRGB(180, 180, 190)
            btn.Parent = ListScroll
            mkCorner(btn, 4)
            btn.MouseButton1Click:Connect(function()
                toggleTarget(plr)
                btn.TextColor3 = isInTargetList(plr) and Color3.fromRGB(120, 220, 160) or Color3.fromRGB(180, 180, 190)
            end)
            RowByPlayer[plr] = btn
        end
        ListScroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 4)
    end

    rebuild()
    Players.PlayerAdded:Connect(function(plr)
        task.wait(0.1)
        rebuild()
    end)
    Players.PlayerRemoving:Connect(function(plr)
        if RowByPlayer[plr] then
            RowByPlayer[plr]:Destroy()
            RowByPlayer[plr] = nil
        end
        removeTarget(plr)
    end)
end

