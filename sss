function cleanup()
    if unloaded then return end
    unloaded = true
    if flyConn then pcall(function() flyConn:Disconnect() end); flyConn = nil end
    if flySaved then
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum.PlatformStand = flySaved.PlatformStand
                hum.WalkSpeed = flySaved.WalkSpeed
            end)
        end
        flySaved = nil
    end
    if fovCircle then pcall(function() fovCircle:Remove() end) end
    for plr, cache in next, ESPCache do
        for _, d in next, cache do pcall(function() d:Remove() end) end
        ESPCache[plr] = nil
    end
    if Gui then pcall(function() Gui:Destroy() end) end
end

