local function tw(obj, props, t)
    TweenService:Create(obj, TweenInfo.new(t or 0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end
local function corner(p, r) local c = Instance.new("UICorner", p); c.CornerRadius = UDim.new(0, r or 8); return c end
local function stroke(p, c, th) local s = Instance.new("UIStroke", p); s.Color = c or ACCENT; s.Thickness = th or 1; return s end
local function pad(p, n) local u = Instance.new("UIPadding", p); u.PaddingLeft = UDim.new(0, n); u.PaddingRight = UDim.new(0, n); u.PaddingTop = UDim.new(0, n); u.PaddingBottom = UDim.new(0, n); return u end

local function isTarget(plr)
    if plr == LP then return false end
    if cfg.aliveOnly then
        local c = plr.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then return false end
    end
    if cfg.teamCheck and plr.Team and plr.Team == LP.Team then return false end
    return true
end

