-- (ensureESP rewritten below, keeping simple)

ESPdrawings = {}
local function ensureESP(plr)
    if ESPdrawings[plr] or not Drawing then return end
    local name = Drawing.new("Text")
    local hp = Drawing.new("Text")
    local dist = Drawing.new("Text")
    for _, d in ipairs({name, hp, dist}) do
        d.Size = 14
        d.Center = true
        d.Outline = true
        d.OutlineColor = Color3.fromRGB(0, 0, 0)
        d.Font = 2
        d.Visible = false
    end
    hp.Size = 12
    dist.Size = 12
    ESPdrawings[plr] = { name = name, hp = hp, dist = dist }
end

local function removeESP(plr)
    local s = ESPdrawings[plr]
    if not s then return end
    for _, d in pairs(s) do d:Remove() end
    ESPdrawings[plr] = nil
end

local function updateESP()
    if not Drawing then return end
    if not Config.ESPEnabled then
        for _, s in pairs(ESPdrawings) do
            for _, d in pairs(s) do d.Visible = false end
        end
        return
    end
    local myRoot = getRoot()
    local myPos = myRoot and myRoot.Position or Camera.CFrame.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        ensureESP(plr)
        local s = ESPdrawings[plr]
        if not s then continue end
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not (char and hum and head and root and hum.Health > 0) then
            for _, d in pairs(s) do d.Visible = false end
            continue
        end
        local distance = (root.Position - myPos).Magnitude
        if distance > Config.ESPMaxDistance then
            for _, d in pairs(s) do d.Visible = false end
            continue
        end
        local sp, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
        if not onScreen then
            for _, d in pairs(s) do d.Visible = false end
            continue
        end
        local vis = isVisible(head)
        local color = vis and Config.ESPColorVisible or Config.ESPColorOccluded
        local baseX, baseY = sp.X, sp.Y
        local offset = 0
        if Config.ESPShowName then
            s.name.Text = plr.Name
            s.name.Color = color
            s.name.Position = Vector2.new(baseX, baseY + offset)
            s.name.Visible = true
            offset = offset + 16
        else
            s.name.Visible = false
        end
        if Config.ESPShowHealth then
            s.hp.Text = string.format("[%d HP]", math.floor(hum.Health))
            s.hp.Color = color
            s.hp.Position = Vector2.new(baseX, baseY + offset)
            s.hp.Visible = true
            offset = offset + 14
        else
            s.hp.Visible = false
        end
        if Config.ESPShowDistance then
            s.dist.Text = string.format("[%dm]", math.floor(distance))
            s.dist.Color = color
            s.dist.Position = Vector2.new(baseX, baseY + offset)
            s.dist.Visible = true
        else
            s.dist.Visible = false
        end
    end
end

------------------------------------------------------------
-- RAPID FIRE / AUTO RELOAD
------------------------------------------------------------
local function rapidFireStep()
    if not Config.RapidFire then return end
    local now = tick()
    if now - LastFire < Config.RapidFireDelay then return end
    LastFire = now
    local char = getCharacter()
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Activate() end) end
end

local function autoReloadStep()
    if not Config.AutoReload then return end
    local now = tick()
    if now - LastReload < Config.ReloadDelay then return end
    LastReload = now
    local char = getCharacter()
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local rr = tool:FindFirstChild("Reload")
        if rr and rr:IsA("RemoteEvent") then
            pcall(function() rr:FireServer() end)
        else
            pcall(function()
                tool:Deactivate(); task.wait(0.05); tool:Activate()
            end)
        end
    end
end

------------------------------------------------------------
-- SPEED
------------------------------------------------------------
local function speedStep()
    local hum = getHumanoid()
    if not hum then return end
    if Config.SpeedEnabled then
        hum.WalkSpeed = Config.WalkSpeed
        hum.JumpPower = Config.JumpPower
    else
        hum.WalkSpeed = 16
        hum.JumpPower = 50
    end
end

------------------------------------------------------------
-- INSTANT STOP
------------------------------------------------------------
local function instantStop()
    local root = getRoot()
    local hum = getHumanoid()
    if not root or not hum then return end
    local saved = root.CFrame
    root.Anchored = true
    root.Velocity = Vector3.zero
    root.RotVelocity = Vector3.zero
    task.wait(0.01)
    root.Anchored = false
    root.CFrame = saved
    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
end

