-- ============================================================
-- AIM LOOP  (smart tracking)
-- ============================================================
RunSvc.RenderStepped:Connect(function(dt)
    if unloaded then return end
    if not (aiming and Config.LockEnabled) then return end

    local target = pickTarget()
    if not target then return end
    local part = getPart(target)
    if not part then return end

    -- velocity-aware prediction, ping-scaled
    local ping = getPing()
    local dist = (Camera.CFrame.Position - part.Position).Magnitude
    local distFactor = math.clamp(dist / 100, 0.6, 1.6)   -- long range = more lead
    local lead = Config.Prediction + ping * 0.5
    local aimPos = part.Position
    if part.AssemblyLinearVelocity then
        aimPos = aimPos + part.AssemblyLinearVelocity * lead * distFactor
    end

    local cf = Camera.CFrame
    local goal = CFrame.lookAt(cf.Position, aimPos)
    local angle = math.deg(math.acos(math.clamp(cf.LookVector:Dot((aimPos - cf.Position).Unit), -1, 1)))

    -- adaptive smoothing: tight when close to target, smooth when far off
    local base = Config.Smoothness
    local adaptive = math.clamp(base * (0.7 + angle / 30), base * 0.7, base * 2.5)
    local alpha = math.clamp(adaptive * dt, 0, 1)

    Camera.CFrame = cf:Lerp(goal, alpha)
end)

