UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Config.AimKey then HoldingAim = true end
    if input.KeyCode == Config.MultiLockKey then HoldingMultiLock = true end
    if input.KeyCode == Config.InstantStopKey and Config.InstantStopEnabled then instantStop() end
    if input.KeyCode == Config.MenuKey then
        if MainFrame then MainFrame.Visible = not MainFrame.Visible end
    end
    if input.KeyCode == Config.PlayerListKey then
        if ListFrame then ListFrame.Visible = not ListFrame.Visible end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Config.AimKey then HoldingAim = false end
    if input.KeyCode == Config.MultiLockKey then HoldingMultiLock = false end
end)

