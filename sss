local function getPing()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and type(v) == "number" then return v / 1000 end
    return 0.08
end

-- ============================================================
-- VALIDATION
-- ============================================================
local function valid(plr)
    if not plr or plr == LP then return false end
    local ch = plr.Character
    if not ch then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function teamOK(plr)
    if not Config.TeamCheck then return true end
    if not LP.Team or not plr.Team then return true end
    return LP.Team.Name ~= plr.Team.Name
end

local function getPart(plr)
    local ch = plr.Character
    if not ch then return nil end
    return ch:FindFirstChild(Config.TargetPart) or ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
end

local function distance(plr)
    local p = getPart(plr)
    if not p then return math.huge end
    return (Camera.CFrame.Position - p.Position).Magnitude
end

local function visible(plr)
    if not Config.VisibleCheck then return true end
    local ch = plr.Character
    if not ch then return false end
    local part = getPart(plr)
    if not part then return false end
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { LP.Character, Camera }
    params.FilterType = Enum.RaycastFilterType.Exclude
    local res = WS:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, params)
    if not res then return true end
    return res.Instance:IsDescendantOf(ch)
end

-- ============================================================
-- FLY
-- ============================================================
local flyConn = nil
local flySaved = nil

local function setFly(on)
    if unloaded then return end
    Config.FlyEnabled = on
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if on then
        if not hum then return end
        if flyConn then return end
        flySaved = { WalkSpeed = hum.WalkSpeed, PlatformStand = hum.PlatformStand }
        hum.PlatformStand = true
        hum.WalkSpeed = 0
        flyConn = RunSvc.RenderStepped:Connect(function(dt)
            if unloaded then return end
            local c = LP.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if not r then return end
            local cam = Camera
            local move = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end
            if move.Magnitude > 0 then
                move = move.Unit * Config.FlySpeed * dt
            else
                move = Vector3.new(0, -8 * dt, 0)
            end
            r.CFrame = r.CFrame + move
        end)
    else
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        if flySaved and hum then
            hum.PlatformStand = flySaved.PlatformStand
            hum.WalkSpeed = flySaved.WalkSpeed
            flySaved = nil
        end
    end
end

LP.CharacterRemoving:Connect(function()
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    flySaved = nil
end)

LP.CharacterAdded:Connect(function()
    if unloaded then return end
    if Config.FlyEnabled then
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        flySaved = nil
        task.wait(0.5)
        if Config.FlyEnabled and not unloaded then setFly(true) end
    end
end)

-- ============================================================
-- FAST RELOAD
-- ============================================================
local reloadDebounce = 0
local function fastReload()
    if unloaded then return end
    local now = tick()
    if now - reloadDebounce < 0.1 then return end
    reloadDebounce = now

    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local tool = char:FindFirstChildOfClass("Tool")
    if not (hum and tool) then return end

    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
        if ok and tracks then
            for _, t in ipairs(tracks) do
                local len = 0
                pcall(function() len = t.Length end)
                if len > 0.4 and len < 3 and t.TimePosition < len - 0.1 then
                    pcall(function() t.TimePosition = len - 0.05 end)
                end
            end
        end
    end
    for _, name in ipairs({"Reloading","IsReloading","Reload","ReloadState"}) do
        local v = tool:FindFirstChild(name, true)
        if v and v:IsA("BoolValue") then pcall(function() v.Value = false end) end
    end
    for _, pair in ipairs({
        {"Ammo","MaxAmmo"}, {"Clip","MaxClip"}, {"Mag","MaxMag"},
        {"CurrentAmmo","MaxAmmo"}, {"Bullets","MaxBullets"},
    }) do
        local cur = tool:FindFirstChild(pair[1], true)
        local mx = tool:FindFirstChild(pair[2], true)
        if cur and mx and (cur:IsA("IntValue") or cur:IsA("NumberValue")) and (mx:IsA("IntValue") or mx:IsA("NumberValue")) then
            pcall(function() cur.Value = mx.Value end)
        end
    end
    for _, child in ipairs(tool:GetDescendants()) do
        if child:IsA("BindableEvent") then
            local n = child.Name:lower()
            if n:find("reload") or n:find("ammo") or n:find("clip") then
                pcall(function() child:Fire() end)
            end
        end
    end
end

