-- ============================================================
-- HELPERS
-- ============================================================
local function mk(class, props, parent)
    local o = Instance.new(class)
    for k, v in next, props do o[k] = v end
    o.Parent = parent
    return o
end

local function corner(o, r)
    return mk("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o)
end

local function stroke(o, c, t)
    return mk("UIStroke", { Color = c or C.line, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end

