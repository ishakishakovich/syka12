-- ============================================================
-- AIMLOCK
-- ============================================================
local function isTargetValid(plr)
    if not plr or plr == LocalPlayer then return false end
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local effects = char:FindFirstChild("BodyEffects")
    if effects then
        local ko = effects:FindFirstChild("K.O")
        if ko and ko.Value then return false end
    end
    if char:FindFirstChild("GRABBING_CONSTRAINT") then return false end
    if not char:FindFirstChild("HumanoidRootPart") then return false end
    return true
end

local function getTargetPart()
    local t = Config.aimlock.target
    if not isTargetValid(t) then return nil end
    return t.Character.HumanoidRootPart
end

RunService:BindToRenderStep("crumb_aimlock", 0, function()
    if not Config.aimlock.enabled then return end
    if not UserInputService:IsKeyDown(Config.aimlock.key) then return end
    local part = getTargetPart()
    if not part then return end
    local hit = part.CFrame + (part.Velocity * Config.aimlock.prediction)
    Workspace.CurrentCamera.CFrame =
        CFrame.lookAt(Workspace.CurrentCamera.CFrame.Position, hit.Position)
end)

-- ============================================================
-- ESP
-- ============================================================
local espHighlights = {}
local espBillboards = {}

local function cleanupESP(plr)
    if espHighlights[plr] then
        pcall(function() espHighlights[plr]:Destroy() end)
        espHighlights[plr] = nil
    end
    if espBillboards[plr] then
        pcall(function() espBillboards[plr]:Destroy() end)
        espBillboards[plr] = nil
    end
end

local function buildESP(plr)
    if plr == LocalPlayer then return end
    cleanupESP(plr)
    local char = plr.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not head or not hum or hum.Health <= 0 then return end

    local hl = Instance.new("Highlight")
    hl.Name               = "crumb_esp_hl"
    hl.FillColor          = Config.esp.fillColor
    hl.OutlineColor       = Config.esp.outlineColor
    hl.FillTransparency   = Config.esp.fillTransp
    hl.OutlineTransparency = 0
    hl.Adornee            = char
    hl.Parent             = char
    espHighlights[plr]    = hl

    local bb = Instance.new("BillboardGui")
    bb.Name          = "crumb_esp_bb"
    bb.Size          = UDim2.new(0, 200, 0, 40)
    bb.StudsOffset   = Vector3.new(0, 2.2, 0)
    bb.AlwaysOnTop   = true
    bb.Adornee       = head
    bb.Parent        = char

    local label = Instance.new("TextLabel")
    label.Size                 = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3           = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0.2
    label.TextSize             = Config.esp.textSize
    label.Font                 = Enum.Font.GothamBold
    label.Text                 = ""
    label.Parent               = bb

    espBillboards[plr] = bb
end

local function refreshAllESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            buildESP(plr)
        end
    end
end

local function destroyAllESP()
    for plr in pairs(espHighlights) do cleanupESP(plr) end
    for plr in pairs(espBillboards) do cleanupESP(plr) end
end

RunService.RenderStepped:Connect(function()
    if not Config.esp.enabled then return end
    if not Config.esp.showNames and not Config.esp.showDistance then return end
    for plr, bb in pairs(espBillboards) do
        if bb and bb.Parent and plr.Character then
            local hrp  = plr.Character:FindFirstChild("HumanoidRootPart")
            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local label = bb:FindFirstChildOfClass("TextLabel")
                if label then
                    local parts = {}
                    if Config.esp.showNames then
                        table.insert(parts, plr.DisplayName)
                    end
                    if Config.esp.showDistance and myHrp then
                        local dist = math.floor((myHrp.Position - hrp.Position).Magnitude)
                        table.insert(parts, "[" .. dist .. "m]")
                    end
                    label.Text = table.concat(parts, " ")
                end
            end
        end
    end
end)

-- ============================================================
-- FAST RELOAD (tool property + animation)
-- ============================================================
local fastReloadConnections = {}
local reloadedTools = {}
local animSpeed = 2

local function tryPatchTool(tool)
    if not Config.fastReload.enabled then return end
    if not tool:IsA("Tool") then return end
    if reloadedTools[tool] then return end
    reloadedTools[tool] = true

    -- 1) Property-based: ищем свойства похожие на время перезарядки
    local props = {"ReloadTime", "Cooldown", "ReloadSpeed", "ReloadDuration", "Reload"}
    for _, propName in ipairs(props) do
        local ok, val = pcall(function() return tool[propName] end)
        if ok and type(val) == "number" and val > 0 then
            pcall(function()
                tool[propName] = val / 2
            end)
        end
    end

    -- 2) Child values with matching names
    for _, child in ipairs(tool:GetChildren()) do
        if child:IsA("NumberValue") or child:IsA("IntValue") then
            local n = child.Name:lower()
            if n:find("reload") or n:find("cooldown") or n:find("duration") then
                pcall(function()
                    child.Value = child.Value / 2
                end)
            end
        end
    end

    -- 3) Animation-based: ловим новые Animation внутри Tool
    table.insert(fastReloadConnections, tool.ChildAdded:Connect(function(child)
        if not Config.fastReload.enabled then return end
        if not child:IsA("Animation") then return end
        if not child.Name:lower():find("reload") then return end
        task.spawn(function()
            local char = LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            local animator = hum:FindFirstChildOfClass("Animator")
            if not animator then return end
            local track = animator:LoadAnimation(child)
            track:Play()
            task.wait(0.05)
            track:AdjustSpeed(animSpeed)
        end)
    end))
end

local function enableFastReload()
    if #fastReloadConnections > 0 then return end
    local function hookChar(char)
        task.wait(0.3)
        if not Config.fastReload.enabled then return end
        -- ловим уже экипированные
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Tool") then tryPatchTool(c) end
        end
        table.insert(fastReloadConnections, char.ChildAdded:Connect(function(child)
            tryPatchTool(child)
        end))
    end
    if LocalPlayer.Character then hookChar(LocalPlayer.Character) end
    table.insert(fastReloadConnections, LocalPlayer.CharacterAdded:Connect(hookChar))
end

local function disableFastReload()
    for _, conn in ipairs(fastReloadConnections) do
        pcall(function() conn:Disconnect() end)
    end
    fastReloadConnections = {}
    reloadedTools = {}
end

