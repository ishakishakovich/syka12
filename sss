local function updateCashESP()
    if not hasDrawing then return end
    if not Config.CashESP then
        for _, b in next, CashCache do pcall(function() b:Remove() end) end
        CashCache = {}
        return
    end
    local parts = findCashParts()
    local seen = {}
    for _, part in ipairs(parts) do
        seen[part] = true
        local b = CashCache[part]
        if not b then
            b = Drawing.new("Square")
            b.Thickness = 1
            b.Color = Color3.fromRGB(120, 255, 140)
            b.Filled = false
            b.Visible = true
            CashCache[part] = b
        end
        local cf, size = part.CFrame, part.Size
        local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
        local any = false
        for ix = 0, 1 do for iy = 0, 1 do for iz = 0, 1 do
            local sp, on = Camera:WorldToViewportPoint(cf * Vector3.new((ix*2-1)*size.X/2, (iy*2-1)*size.Y/2, (iz*2-1)*size.Z/2))
            if on then
                any = true
                minX = math.min(minX, sp.X); maxX = math.max(maxX, sp.X)
                minY = math.min(minY, sp.Y); maxY = math.max(maxY, sp.Y)
            end
        end end end
        if any then
            b.Size = Vector2.new(maxX - minX, maxY - minY)
            b.Position = Vector2.new(minX, minY)
            b.Visible = true
        else
            b.Visible = false
        end
    end
    for p, b in next, CashCache do
        if not seen[p] then pcall(function() b:Remove() end); CashCache[p] = nil end
    end
end

