local function killESP(plr)
    local e = esp[plr]; if not e then return end
    pcall(function() e.bb:Destroy() end)
    pcall(function() e.hl:Destroy() end)
    esp[plr] = nil
end

function updateESP()
    for plr, e in pairs(esp) do
        if not selected[plr] or not plr.Character then killESP(plr) end
    end
    for plr in pairs(selected) do
        makeESP(plr)
        local e = esp[plr]
        if e then
            e.name.Visible = cfg.espName
            e.dist.Visible = cfg.espDistance
            e.hpBg.Visible = cfg.espHealth
            e.hl.Visible = cfg.espHighlight
        end
    end
end

-- ========================= TARGET PICKING =========================
function getSelectedList()
    local list = {}
    for plr in pairs(selected) do
        if isTarget(plr) and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then table.insert(list, plr) end
        end
    end
    return list
end

function cycleTarget()
    local list = getSelectedList()
    if #list == 0 then return end
    lockedIndex = (lockedIndex % #list) + 1
end

local function pickTarget(list)
    if #list == 0 then return nil end
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return list[lockedIndex % #list + 1] end
    if cfg.priority == "Health" then
        table.sort(list, function(a, b)
            local ha = a.Character:FindFirstChildOfClass("Humanoid")
            local hb = b.Character:FindFirstChildOfClass("Humanoid")
            return (ha and ha.Health or 999) < (hb and hb.Health or 999)
        end)
        return list[1]
    elseif cfg.priority == "Cursor" then
        local best, bestD = nil, math.huge
        local c = Camera:WorldToViewportPoint(hrp.Position)
        local mpos = UIS:GetMouseLocation()
        for _, p in ipairs(list) do
            local wp = p.Character.HumanoidRootPart.Position
            local sp = Camera:WorldToViewportPoint(wp)
            local d = (Vector2.new(sp.X, sp.Y) - mpos).Magnitude
            if d < bestD then bestD = d; best = p end
        end
        return best
    else
        table.sort(list, function(a, b)
            return (a.Character.HumanoidRootPart.Position - hrp.Position).Magnitude <
                   (b.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
        end)
        return list[1]
    end
end

-- ========================= RENDER LOOP =========================
RunService.RenderStepped:Connect(function()
    -- обновление ESP данных
    for plr, e in pairs(esp) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if myHrp then
                e.dist.Text = string.format("%d studs", math.floor((hrp.Position - myHrp.Position).Magnitude))
            end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                e.hpFill.Size = UDim2.new(ratio, 0, 1, 0)
                e.hpFill.BackgroundColor3 = Color3.fromRGB(
                    math.floor(255 * (1 - ratio) + 90 * ratio),
                    math.floor(90 * (1 - ratio) + 220 * ratio),
                    100
                )
            end
        end
    end

    -- лок/аим
    if not cfg.lockActive or cfg.lockMode == "Off" then return end
    local list = getSelectedList()
    if #list == 0 then return end
    if lockedIndex > #list then lockedIndex = 1 end
    local target = (cfg.priority == "Cursor" or cfg.priority ~= "Distance") and pickTarget(list) or list[lockedIndex]
    if not target or not target.Character then return end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if cfg.lockMode == "Camera" then
        local goal = CFrame.new(Camera.CFrame.Position, hrp.Position + Vector3.new(0, 1.5, 0))
        Camera.CFrame = Camera.CFrame:Lerp(goal, math.clamp(cfg.smoothness / 40, 0.05, 1))
    elseif cfg.lockMode == "Silent" then
        local sp, onScreen = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 1.5, 0))
        if onScreen then
            local center = Camera.ViewportSize / 2
            local delta = Vector2.new(sp.X, sp.Y) - center
            if delta.Magnitude <= cfg.fov then
                mousemoverel(delta.X / math.max(cfg.smoothness, 1), delta.Y / math.max(cfg.smoothness, 1))
            end
        end
    end
end)

-- ========================= INPUT =========================
UIS.InputBegan:Connect(function(input, proc)
    if proc then return end
    if input.KeyCode == cfg.lockKey then
        cfg.lockActive = not cfg.lockActive
        fovCircle.Visible = (cfg.lockActive and cfg.lockMode == "Silent")
    elseif input.KeyCode == cfg.cycleKey then
        cycleTarget()
    elseif input.KeyCode == cfg.toggleMenu then
        Main.Visible = not Main.Visible
    end
end)

-- ========================= LIFECYCLE =========================
Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.6)
        if selected[plr] then makeESP(plr) end
        refreshTargets()
    end)
    refreshTargets()
end)
Players.PlayerRemoving:Connect(function(plr)
    selected[plr] = nil
    killESP(plr)
    refreshTargets()
end)

CloseB.MouseButton1Click:Connect(function() tw(Main, {Size = UDim2.new(0, 0, 0, 0)}, 0.15); task.delay(0.16, function() Main.Visible = false; Main.Size = UDim2.new(0, 620, 0, 400) end) end)
MinB.MouseButton1Click:Connect(function() Main.Visible = false end)

refreshTargets()
