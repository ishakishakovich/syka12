------------------------------------------------------------
-- HELPERS
------------------------------------------------------------
local function getCharacter() return LocalPlayer.Character end
local function getRoot()
    local c = getCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHumanoid()
    local c = getCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function isAlive(plr)
    if not plr or plr == LocalPlayer then return false end
    local c = plr.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end
local function getPart(plr, partName)
    local c = plr.Character
    if not c then return nil end
    return c:FindFirstChild(partName) or c:FindFirstChild("HumanoidRootPart")
end
local function isVisible(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    local res = workspace:Raycast(origin, dir, rp)
    if not res then return true end
    return res.Instance:IsDescendantOf(part.Parent)
end

------------------------------------------------------------
-- MULTI-LOCK
------------------------------------------------------------
local function isInTargetList(plr)
    for _, p in ipairs(Config.TargetList) do
        if p == plr then return true end
    end
    return false
end
local function addTarget(plr)
    if plr == LocalPlayer or isInTargetList(plr) then return end
    table.insert(Config.TargetList, plr)
end
local function removeTarget(plr)
    for i, p in ipairs(Config.TargetList) do
        if p == plr then table.remove(Config.TargetList, i) return end
    end
end
local function toggleTarget(plr)
    if isInTargetList(plr) then removeTarget(plr) else addTarget(plr) end
end
local function getClosestFromTargetList()
    local mousePos = UserInputService:GetMouseLocation()
    local best, bestPart, bestDist = nil, nil, math.huge
    for _, plr in ipairs(Config.TargetList) do
        if not isAlive(plr) then continue end
        local part = getPart(plr, Config.AimPart)
        if not part then continue end
        if Config.AimVisibleCheck and not isVisible(part) then continue end
        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
        if dist < bestDist then
            bestDist = dist; best = plr; bestPart = part
        end
    end
    return best, bestPart
end

------------------------------------------------------------
-- AIM
------------------------------------------------------------
local function getClosestTarget()
    if Config.MultiLockEnabled and HoldingMultiLock and #Config.TargetList > 0 then
        local t, p = getClosestFromTargetList()
        if t then return t, p end
    end
    if Config.TargetLocked and isAlive(Config.TargetLocked) then
        local part = getPart(Config.TargetLocked, Config.AimPart)
        if part and (not Config.AimVisibleCheck or isVisible(part)) then
            return Config.TargetLocked, part
        end
    end
    local mousePos = UserInputService:GetMouseLocation()
    local best, bestDist = nil, Config.AimFOV
    for _, plr in ipairs(Players:GetPlayers()) do
        if not isAlive(plr) then continue end
        local part = getPart(plr, Config.AimPart)
        if not part then continue end
        if Config.AimVisibleCheck and not isVisible(part) then continue end
        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
        if dist < bestDist then bestDist = dist; best = plr end
    end
    return best
end

local function aimStep()
    if not Config.AimEnabled then return end
    local wantsLock = HoldingAim
        or Config.TargetLocked ~= nil
        or (Config.MultiLockEnabled and HoldingMultiLock and #Config.TargetList > 0)
    if not wantsLock then return end

    local target, part = getClosestTarget()
    if not target or not part then return end

    local sp = Camera:WorldToViewportPoint(part.Position)
    local mp = UserInputService:GetMouseLocation()
    local dx = (sp.X - mp.X) * Config.AimSmooth
    local dy = (sp.Y - mp.Y) * Config.AimSmooth
    if math.abs(dx) > 0.5 or math.abs(dy) > 0.5 then
        mousemoverel(dx, dy)
    end
end

