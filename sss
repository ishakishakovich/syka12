local function makeToggle(parent, y, text, initial, cb)
    local row = mk("TextButton", {
        Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0, y),
        BackgroundColor3 = C.panel, Text = "", AutoButtonColor = false,
    }, parent)
    corner(row, 6)
    mk("TextLabel", {
        Size = UDim2.new(1, -50, 1, 0), Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1, Text = text, TextSize = 12,
        Font = Enum.Font.Gotham, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local state = initial
    local track = mk("Frame", {
        Size = UDim2.fromOffset(32, 16), Position = UDim2.new(1, -44, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = state and C.accent or C.line,
    }, row)
    corner(track, 8)
    local knob = mk("Frame", {
        Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0, 0.5),
        Position = state and UDim2.new(1, -14, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
        BackgroundColor3 = C.text,
    }, track)
    corner(knob, 6)
    row.MouseButton1Click:Connect(function()
        state = not state
        track.BackgroundColor3 = state and C.accent or C.line
        knob:TweenPosition(state and UDim2.new(1, -14, 0.5, 0) or UDim2.new(0, 2, 0.5, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        cb(state)
    end)
    return 34
end

local function makeSlider(parent, y, text, min, max, initial, cb)
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 46), Position = UDim2.new(0, 0, 0, y),
        BackgroundColor3 = C.panel,
    }, parent)
    corner(row, 6)
    mk("TextLabel", {
        Size = UDim2.new(1, -70, 0, 20), Position = UDim2.new(0, 12, 0, 6),
        BackgroundTransparency = 1, Text = text, TextSize = 12,
        Font = Enum.Font.Gotham, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local valueLbl = mk("TextLabel", {
        Size = UDim2.new(0, 60, 0, 20), Position = UDim2.new(1, -70, 0, 6),
        BackgroundTransparency = 1, Text = tostring(initial), TextSize = 12,
        Font = Enum.Font.GothamMedium, TextColor3 = C.accent, TextXAlignment = Enum.TextXAlignment.Right,
    }, row)
    local bar = mk("Frame", {
        Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 0, 30),
        BackgroundColor3 = C.line,
    }, row)
    corner(bar, 3)
    local pct = (initial - min) / (max - min)
    local fill = mk("Frame", { Size = UDim2.new(pct, 0, 1, 0), BackgroundColor3 = C.accent }, bar)
    corner(fill, 3)
    local dragging = false
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UIS.InputChanged:Connect(function(i)
        if unloaded then return end
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local val = min + (max - min) * rel
            if max > 1 then val = math.floor(val + 0.5) else val = math.floor(val * 100) / 100 end
            fill.Size = UDim2.new(rel, 0, 1, 0)
            valueLbl.Text = tostring(val)
            cb(val)
        end
    end)
    return 50
end

