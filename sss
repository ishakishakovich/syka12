-- ============================================================
-- MOVEMENT LOOPS  (speed / spider / step / infinite jump / anti-fling)
-- ============================================================
RunSvc.RenderStepped:Connect(function(dt)
    if unloaded then return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- speed via CFrame walk direction
    if Config.SpeedHack and not Config.FlyEnabled then
        local move = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + Camera.CFrame.RightVector end
        if move.Magnitude > 0 then
            local flat = Vector3.new(move.X, 0, move.Z).Unit
            local speedFactor = Config.SpeedValue / 16
            hrp.CFrame = hrp.CFrame + flat * dt * Config.SpeedValue * 0.4
        end
    end

    -- spider: climb if touching wall and W held
    if Config.Spider and not Config.FlyEnabled then
        if UIS:IsKeyDown(Enum.KeyCode.W) then
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = { char }
            params.FilterType = Enum.RaycastFilterType.Exclude
            local wall = WS:Raycast(hrp.Position, Camera.CFrame.LookVector * 3, params)
            if wall then
                hrp.CFrame = hrp.CFrame + Vector3.new(0, dt * 20, 0)
            end
        end
    end

    -- step: boost up small ledges
    if Config.Step and not Config.FlyEnabled then
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = { char }
        params.FilterType = Enum.RaycastFilterType.Exclude
        local front = hrp.Position + (Camera.CFrame.LookVector * 2)
        local hit = WS:Raycast(hrp.Position, (front - hrp.Position), params)
        if hit then
            local above = WS:Raycast(hrp.Position + Vector3.new(0, 3, 0), (front - hrp.Position), params)
            if not above then
                hrp.CFrame = hrp.CFrame + Vector3.new(0, 0.5, 0) + Camera.CFrame.LookVector * 0.6
            end
        end
    end

    -- infinite jump
    if Config.InfiniteJump and hum.FloorMaterial == Enum.Material.Air then
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Freefall then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end

    -- anti fling: freeze own horizontal velocity if big spike
    if Config.AntiFling then
        local v = hrp.AssemblyLinearVelocity
        if v.Magnitude > 200 then
            hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y * 0.2, 0)
        end
    end
end)

