-- ====================== СПИСОК ИГРОКОВ ======================
local function rebuildPlayerList()
    for _, child in ipairs(PlayerListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local entry = Instance.new("TextButton")
        entry.Size = UDim2.new(1, -8, 0, 34)
        entry.BackgroundColor3 = selected[plr] and Color3.fromRGB(45, 110, 45) or Color3.fromRGB(32, 32, 38)
        entry.Text = (selected[plr] and "[x] " or "[ ] ") .. plr.Name
        entry.TextColor3 = Color3.fromRGB(220, 220, 230)
        entry.Font = Enum.Font.Gotham
        entry.TextSize = 12
        entry.TextXAlignment = Enum.TextXAlignment.Left
        entry.Parent = PlayerListFrame
        Instance.new("UICorner", entry).CornerRadius = UDim.new(0, 5)

        entry.MouseButton1Click:Connect(function()
            selected[plr] = not selected[plr]
            if not selected[plr] then selected[plr] = nil end
            rebuildPlayerList()
            updateESP()
        end)
    end
    PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 8)
end

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        updateESP()
    end)
    rebuildPlayerList()
end)
Players.PlayerRemoving:Connect(function(plr)
    selected[plr] = nil
    if espObjects[plr] then
        pcall(function()
            espObjects[plr].billboard:Remove()
            espObjects[plr].highlight:Destroy()
        end)
        espObjects[plr] = nil
    end
    rebuildPlayerList()
end)

-- ====================== ESP ======================
local function createESPForPlayer(plr)
    if espObjects[plr] then return end
    local char = plr.Character
    if not char or not char:FindFirstChild("Head") then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DH_ESP"
    billboard.Size = UDim2.new(0, 200, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = char.Head

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.6, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = plr.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0.3
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 14
    nameLabel.Parent = billboard

    local highlight = Instance.new("Highlight")
    highlight.Adornee = char
    highlight.FillColor = Color3.fromRGB(255, 60, 60)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.65
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = char

    espObjects[plr] = { billboard = billboard, highlight = highlight }
end

local function removeESPForPlayer(plr)
    local data = espObjects[plr]
    if not data then return end
    pcall(function() data.billboard:Destroy() end)
    pcall(function() data.highlight:Destroy() end)
    espObjects[plr] = nil
end

local function updateESP()
    for plr, data in pairs(espObjects) do
        if not selected[plr] or not plr.Character or not plr.Character:FindFirstChild("Head") then
            removeESPForPlayer(plr)
        end
    end
    for plr in pairs(selected) do
        if plr.Character and plr.Character:FindFirstChild("Head") then
            createESPForPlayer(plr)
        end
    end
end

-- обновление ESP при респавне
RunService.Heartbeat:Connect(function()
    updateESP()
end)

-- ====================== LOCK-ON ======================
local lockedIndex = 1
local function getSelectedList()
    local list = {}
    for plr in pairs(selected) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                table.insert(list, plr)
            end
        end
    end
    return list
end

local function lockCameraToPlayer(plr)
    if not plr or not plr.Character then return end
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local targetPos = hrp.Position + Vector3.new(0, 1.5, 0)
    local currentCF = Camera.CFrame
    local newCF = CFrame.new(currentCF.Position, targetPos)
    Camera.CFrame = Camera.CFrame:Lerp(newCF, 0.35)
end

local function cycleTarget()
    local list = getSelectedList()
    if #list == 0 then return end
    lockedIndex = (lockedIndex % #list) + 1
end

-- ====================== KEYBINDS ======================
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == lockKey then
        lockActive = not lockActive
    elseif input.KeyCode == cycleKey then
        cycleTarget()
    elseif input.KeyCode == Enum.KeyCode.V then
        menuOpen = not menuOpen
        Main.Visible = menuOpen
    end
end)

-- ====================== КНОПКИ ======================
LockBtn.MouseButton1Click:Connect(function()
    if #getSelectedList() == 0 then
        StatusLabel.Text = "no targets selected."
        return
    end
    lockActive = true
    StatusLabel.Text = "locked: " .. #getSelectedList() .. " target(s)"
end)

UnlockBtn.MouseButton1Click:Connect(function()
    lockActive = false
    StatusLabel.Text = "unlocked."
end)

CycleBtn.MouseButton1Click:Connect(function()
    cycleTarget()
    local list = getSelectedList()
    if #list > 0 then
        StatusLabel.Text = "target: " .. list[lockedIndex].Name
    end
end)

CloseMenuBtn.MouseButton1Click:Connect(function()
    menuOpen = false
    Main.Visible = false
end)

-- ====================== MAIN LOOP ======================
RunService.RenderStepped:Connect(function()
    if not lockActive then return end
    local list = getSelectedList()
    if #list == 0 then return end
    if lockedIndex > #list then lockedIndex = 1 end
    local target = list[lockedIndex]
    if target and target.Character then
        lockCameraToPlayer(target)
    end
end)

-- ====================== INIT ======================
rebuildPlayerList()
Main.Visible = true
