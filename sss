-- CLEANUP
-- ============================================================
function cleanup()
    if unloaded then return end
    unloaded = true
    if flyConn then pcall(function() flyConn:Disconnect() end); flyConn = nil end
    if flySaved then
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum.PlatformStand = flySaved.PlatformStand; hum.WalkSpeed = flySaved.WalkSpeed end)
        end
        flySaved = nil
    end
    for _, c in ipairs(noClipConns) do pcall(function() c:Disconnect() end) end
    noClipConns = {}
    if fovCircle then pcall(function() fovCircle:Remove() end) end
    for plr, cache in next, ESPCache do
        for k, d in next, cache do
            if k == "bones" then
                for _, l in ipairs(d) do pcall(function() l:Remove() end) end
            else
                pcall(function() d:Remove() end)
            end
        end
        ESPCache[plr] = nil
    end
    for _, h in next, ChamsCache do pcall(function() h:Destroy() end) end
    ChamsCache = {}
    for _, b in next, CashCache do pcall(function() b:Remove() end) end
    CashCache = {}
    if Gui then pcall(function() Gui:Destroy() end) end
end

