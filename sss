-- TRIGGER BOT / AUTO FIRE
-- ============================================================
RunSvc.RenderStepped:Connect(function()
    if unloaded then return end
    if not (Config.TriggerBot or Config.AutoFire) then return end
    local char = LP.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool then return end

    local function tryFire()
        if math.random(1, 100) > Config.HitChance then return end
        pcall(function() tool:Activate() end)
    end

    if Config.AutoFire then
        local target = Config.SelectedTarget or stickyTarget
        if target and valid(target) and distance(target) <= Config.TriggerRange then tryFire() end
        return
    end

    -- trigger bot: aim crosshair on target within range
    local center = Camera.ViewportSize / 2
    for _, plr in ipairs(Players:GetPlayers()) do
        if valid(plr) and teamOK(plr) then
            local part = getPart(plr)
            if part and visible(plr) then
                local sp, on = Camera:WorldToViewportPoint(part.Position)
                if on and (Vector2.new(sp.X, sp.Y) - Vector2.new(center.X, center.Y)).Magnitude < 40 then
                    if distance(plr) <= Config.TriggerRange then
                        tryFire()
                        break
                    end
                end
            end
        end
    end
end)

